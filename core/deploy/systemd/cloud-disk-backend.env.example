EMAIL_HOST=smtp.qq.com
EMAIL_ENABLED=true
EMAIL_PORT=587
EMAIL_USER=your_email@qq.com
EMAIL_PASSWORD=your_email_auth_code

REDIS_HOST=localhost
REDIS_PORT=6379

OSS_ACCESS_KEY_ID=your_oss_access_key
OSS_ACCESS_KEY_SECRET=your_oss_secret_key
OSS_BUCKET_NAME=your_oss_bucket
OSS_REGION=oss-cn-beijing

VOLCENGINE_ACCESS_KEY_ID=your_tos_access_key
VOLCENGINE_SECRET_ACCESS_KEY=your_tos_secret_key
VOLCENGINE_REGION=cn-beijing

# ===========================
# 存储服务配置 (Storage Service)
# ===========================

# 存储类型: "oss" 或 "tos"
# oss   - 阿里云对象存储服务 (Alibaba Cloud OSS)
# tos   - 火山云对象存储服务 (Volcengine TOS)
STORAGE_TYPE=tos

# ===========================
# 阿里云 OSS 配置
# ===========================
OSS_ACCESS_KEY_ID=your_oss_access_key
OSS_ACCESS_KEY_SECRET=your_oss_secret_key
OSS_REGION=cn-beijing
OSS_BUCKET_NAME=your-oss-bucket
# OSS_HOST=your-oss-host (可选，用于自定义端点)

# ===========================
# 火山云 TOS 配置
# ===========================
# 仅在 STORAGE_TYPE=tos 时需要配置以下参数
VOLCENGINE_ACCESS_KEY_ID=your_tos_access_key
VOLCENGINE_SECRET_ACCESS_KEY=your_tos_secret_key
VOLCENGINE_REGION=cn-beijing
VOLCENGINE_ENDPOINT=tos-cn-beijing.ivolces.com
VOLCENGINE_PRESIGN_ENDPOINT=tos-cn-beijing.volces.com
VOLCENGINE_BUCKET_NAME=your-tos-bucket

# ===========================
# 数据库配置 (Database)
# ===========================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=cloud_disk

# ===========================
# Redis 配置
# ===========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================
# RabbitMQ 配置
# ===========================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ===========================
# 邮件服务配置 (Email Service)
# ===========================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password

# ===========================
# 日志配置 (Logging)
# ===========================
LOG_LEVEL=info

# ===========================
# CORS 配置
# ===========================
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
